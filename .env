# ============================================================
# REVIWEE - ROOT ENVIRONMENT CONFIGURATION
# All 4 projects are configured from this single file
# ============================================================
 
# ---- NODE ENVIRONMENT ----
NODE_ENV=production
 
# ---- PORTS ----
API_PORT=7000
SUPER_ADMIN_PORT=3000
USER_ADMIN_PORT=3001
WEB_PORT=3002
 
# ---- MONGODB ----
MONGO_ROOT_USERNAME=reviwee_root
MONGO_ROOT_PASSWORD=Reviwee@Mongo#2024
MONGO_DB_NAME=reviwee_db
MONGO_DB_USER=reviwee_user
MONGO_DB_PASSWORD=Reviwee@DB#2024
MONGO_PORT=27017
MONGO_URI=mongodb://reviwee_user:Reviwee@DB#2024@mongodb:27017/reviwee_db?authSource=reviwee_db
 
# ---- REDIS ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=Reviwee@Redis#2024
REDIS_URL=redis://:Reviwee@Redis#2024@redis:6379
 
# ---- JWT AUTH ----
JWT_SECRET=reviwee_jwt_super_secret_key_2024_do_not_share
JWT_ACCESS_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=30
JWT_RESET_PASSWORD_EXPIRATION_MINUTES=10
JWT_VERIFY_EMAIL_EXPIRATION_MINUTES=10
 
# ---- ADMIN SEED CREDENTIALS ----
SEED_ADMIN_EMAIL=admin@reviwee.com
SEED_ADMIN_PASSWORD=Admin@123
SEED_ADMIN_NAME=Super Admin
 
# ---- API URLS (used by frontends) ----
VITE_API_BASE_URL=http://localhost:7000/v1
VITE_SOCKET_URL=http://localhost:7000
 
# ---- CORS ORIGINS ----
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
 
# ---- EMAIL (nodemailer) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@reviwee.com
SMTP_PASS=your_smtp_password_here
EMAIL_FROM=noreply@reviwee.com
 
# ---- GOOGLE OAUTH ----
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
 
# ---- RAZORPAY ----
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id_here
 
# ---- FILE UPLOAD ----
UPLOAD_PATH=/app/public/uploads
MAX_FILE_SIZE=10485760
 
# ---- APP MODE ----
MODE=production
 